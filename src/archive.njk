---
layout: layouts/page.njk
title: Archive
permalink: /archive/
schemaKind: CollectionPage
wide: true
tags:
  - page
updated: 2026-10-22
breadcrumbs:
  - name: Home
    url: /
  - name: Archive
    url: /archive/
---
{% if collections.posts.length == 0 %}
  <p>No stories have been published yet.</p>
{% else %}
  {% for group in collections.posts | groupByMonth %}
    <h2 class="archive-month">{{ group.label }}</h2>
    <ul class="archive-list">
      {% for post in group.posts %}
        {% set cat = categories | categoryBySlug(post.data.category) %}
        <li>
          <p class="kicker"><a href="/category/{{ cat.slug }}/">{{ cat.title }}</a></p>
          <h3><a href="{{ post.url }}">{{ post.data.title }}</a></h3>
          <p class="byline"><time datetime="{{ post.date | isoDate }}">{{ post.date | readableDate }}</time></p>
        </li>
      {% endfor %}
    </ul>
  {% endfor %}
{% endif %}
