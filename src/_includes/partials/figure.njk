{% set img = picture | storyImage %}
<figure class="story-media{% if className %} {{ className }}{% endif %}">
  <picture>
    {% if img.srcsetAvif %}
      <source type="image/avif" srcset="{{ img.srcsetAvif }}" sizes="{{ sizes or '(min-width: 64rem) 42rem, 100vw' }}">
    {% endif %}
    {% if img.srcsetWebp %}
      <source type="image/webp" srcset="{{ img.srcsetWebp }}" sizes="{{ sizes or '(min-width: 64rem) 42rem, 100vw' }}">
    {% endif %}
    <img
      src="{{ img.src }}"
      alt="{{ img.alt }}"
      width="{{ img.width }}"
      height="{{ img.height }}"
      loading="{{ loading or 'lazy' }}"
      decoding="async"
      {% if fetchpriority %}fetchpriority="{{ fetchpriority }}"{% endif %}
    >
  </picture>
  {% if img.aiGenerated or img.credit %}
    <figcaption>
      {% if img.aiGenerated %}<span class="ai-label">AI-generated image</span>{% endif %}
      {% if img.credit %}
      <span class="figure-credit">
        {{ img.credit }}
        {% if img.source_url %}
          · <a href="{{ img.source_url }}"{% if img.source_url.slice(0, 4) == "http" %} rel="noopener noreferrer"{% endif %}>{{ img.licence or "Source" }}</a>
        {% elif img.licence %}
          · {{ img.licence }}
        {% endif %}
      </span>
      {% endif %}
    </figcaption>
  {% endif %}
</figure>
