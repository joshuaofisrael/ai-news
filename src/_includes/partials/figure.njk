{% set img = picture | storyImage %}
<figure class="story-media{% if className %} {{ className }}{% endif %}">
  <picture>
    {% if img.srcsetAvif %}
      <source type="image/avif" srcset="{{ img.srcsetAvif }}" sizes="{{ sizes or '(min-width: 64rem) 42rem, 100vw' }}">
    {% endif %}
    {% if img.srcsetWebp %}
      <source type="image/webp" srcset="{{ img.srcsetWebp }}" sizes="{{ sizes or '(min-width: 64rem) 42rem, 100vw' }}">
    {% endif %}
    <img
      src="{{ img.src }}"
      alt="{{ img.alt }}"
      width="{{ img.width }}"
      height="{{ img.height }}"
      loading="{{ loading or 'lazy' }}"
      decoding="async"
      {% if fetchpriority %}fetchpriority="{{ fetchpriority }}"{% endif %}
    >
  </picture>
  {% if img.credit %}
    <figcaption>
      {% if img.credit %}
      <span class="figure-credit">
        {{ img.credit }}
      </span>
      {% endif %}
    </figcaption>
  {% endif %}
</figure>
