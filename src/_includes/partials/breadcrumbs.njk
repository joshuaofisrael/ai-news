{% if breadcrumbs and breadcrumbs.length > 1 %}
<nav class="crumbs-wrap" aria-label="Breadcrumb">
  <ol class="crumbs">
    {% for crumb in breadcrumbs %}
      <li>
        {% if loop.last %}
          <span aria-current="page">{{ crumb.name }}</span>
        {% else %}
          <a href="{{ crumb.url }}">{{ crumb.name }}</a>
        {% endif %}
      </li>
    {% endfor %}
  </ol>
</nav>
{% endif %}
