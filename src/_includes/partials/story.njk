{% set cat = categories | categoryBySlug(post.data.category) %}
<article class="story story-{{ cat.slug }} {{ variant }} reveal">
  {% if showImage and post.data.image %}
    {% set picture = post.data.image %}
    {% set className = "" %}
    {% set loading = "eager" if variant == "lead" else "lazy" %}
    {% include "partials/figure.njk" %}
  {% endif %}
  <div class="story-copy">
    <p class="kicker"><a href="/category/{{ cat.slug }}/">{{ cat.title }}</a></p>
    {% if level == 3 %}
      <h3 class="story-title"><a href="{{ post.url }}">{{ post.data.title }}</a></h3>
    {% else %}
      <h2 class="story-title"><a href="{{ post.url }}">{{ post.data.title }}</a></h2>
    {% endif %}
    {% if showDeck != false %}
      <p class="deck">{{ post.data.description }}</p>
    {% endif %}
    <p class="byline"><time datetime="{{ post.date | isoDate }}">{{ post.date | readableDate }}</time></p>
  </div>
</article>
