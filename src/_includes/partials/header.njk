<header class="site-header">
  <div class="wrap">
    <div class="utility">
      <p>{{ site.legalName }}</p>
      <p>
        <a href="/feed.xml">RSS</a>
        <span aria-hidden="true"> · </span>
        <a href="/about/">About</a>
      </p>
    </div>
    <div class="masthead">
      <p class="masthead-mark" aria-hidden="true">
        <svg viewBox="0 0 48 48" width="48" height="48" focusable="false">
          <circle cx="24" cy="24" r="4" fill="currentColor"/>
          <circle cx="8" cy="12" r="2.4" fill="#f4f7f8"/>
          <circle cx="40" cy="14" r="2.4" fill="#f4f7f8"/>
          <circle cx="10" cy="36" r="2.4" fill="#f4f7f8"/>
          <circle cx="38" cy="36" r="2.4" fill="#f4f7f8"/>
          <path d="M10 13.5 20.5 21.5M37.5 15.5 27.5 21.5M12 34.5 20.5 27M36 34.5 27.5 27" stroke="currentColor" stroke-width="1.6" fill="none"/>
        </svg>
      </p>
      <div>
        {% if mastheadHeading %}
          <h1 class="masthead-title"><a href="/">{{ site.name }}</a></h1>
        {% else %}
          <p class="masthead-title"><a href="/">{{ site.name }}</a></p>
        {% endif %}
        <p class="tagline">{{ site.tagline }}</p>
        <p class="edition">
          {% if collections.posts.length %}
            Latest story {{ collections.posts[0].date | readableDate }}
          {% else %}
            No stories published yet
          {% endif %}
        </p>
      </div>
    </div>
    <hr class="rule-double">
    <nav class="section-nav" aria-label="Sections">
      <ul>
        {% for category in categories %}
          {% set catHref = "/category/" + category.slug + "/" %}
          <li>
            <a href="{{ catHref }}" {% if page.url == (catHref | href) %}aria-current="page"{% endif %}>{{ category.title }}</a>
          </li>
        {% endfor %}
        <li><a href="/archive/" {% if page.url == ("/archive/" | href) %}aria-current="page"{% endif %}>Archive</a></li>
        <li><a href="/about/" {% if page.url == ("/about/" | href) %}aria-current="page"{% endif %}>About</a></li>
      </ul>
    </nav>
  </div>
</header>
