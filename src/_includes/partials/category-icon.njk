{% macro category(slug) %}
<svg class="cat-icon" viewBox="0 0 24 24" width="24" height="24" aria-hidden="true" focusable="false">
  {% if slug == "models-research" %}
    <path d="M5 7h14M5 12h14M5 17h9" fill="none" stroke="currentColor" stroke-width="1.6"/>
  {% elif slug == "industry-business" %}
    <path d="M4 18V9l4-2v11M12 18V6l8 3v9" fill="none" stroke="currentColor" stroke-width="1.6"/>
    <path d="M3 18h18" fill="none" stroke="currentColor" stroke-width="1.6"/>
  {% elif slug == "policy-regulation" %}
    <path d="M12 3 5 6v6c0 4 2.8 6.6 7 8 4.2-1.4 7-4 7-8V6l-7-3Z" fill="none" stroke="currentColor" stroke-width="1.6"/>
    <path d="M9 12h6" fill="none" stroke="currentColor" stroke-width="1.6"/>
  {% elif slug == "tools-products" %}
    <rect x="4" y="4" width="16" height="16" rx="2" fill="none" stroke="currentColor" stroke-width="1.6"/>
    <path d="M8 9h8M8 12h8M8 15h5" fill="none" stroke="currentColor" stroke-width="1.4"/>
  {% else %}
    <circle cx="12" cy="12" r="7" fill="none" stroke="currentColor" stroke-width="1.6"/>
    <path d="M12 8.5v7.5" fill="none" stroke="currentColor" stroke-width="1.6"/>
  {% endif %}
</svg>
{% endmacro %}
