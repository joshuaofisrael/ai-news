<!DOCTYPE html>
<html lang="{{ site.lang }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <script>window.dataLayer=window.dataLayer||[];function gtag(){dataLayer.push(arguments);}gtag('consent','default',{ad_storage:'denied',ad_user_data:'denied',ad_personalization:'denied',analytics_storage:'denied',wait_for_update:500});try{if(localStorage.getItem('ahh-analytics-consent')==='granted'){gtag('consent','update',{ad_storage:'granted',ad_user_data:'granted',ad_personalization:'granted',analytics_storage:'granted'});}}catch(e){}</script>
  <meta name="google-adsense-account" content="ca-pub-5681559774142917">
  <script async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-5681559774142917" crossorigin="anonymous"></script>
  {% if mastheadHeading %}
    {% set hero = site.heroImage | storyImage %}
    <link rel="preload" as="image" type="image/avif" imagesrcset="{{ hero.srcsetAvif }}" imagesizes="100vw" fetchpriority="high">
  {% endif %}
  {% include "partials/seo.njk" %}
  <link rel="stylesheet" href="/assets/css/site.css">
</head>
<body>
  <a class="skip-link" href="#main">Skip to content</a>
  {% include "partials/header.njk" %}
  <main id="main" tabindex="-1">
    {{ content | safe }}
  </main>
  {% include "partials/footer.njk" %}
  <script src="/assets/js/motion.js" defer></script>
  <script src="/assets/js/consent.js" data-ga="{{ site.ga4Id }}" defer></script>
  {% for script in extraScripts or [] %}
  <script src="{{ script }}" defer></script>
  {% endfor %}
  {% if site.cfBeaconToken %}
  <script defer src="https://static.cloudflareinsights.com/beacon.min.js" data-cf-beacon='{"token": "{{ site.cfBeaconToken }}"}'></script>
  {% endif %}
</body>
</html>
