---
layout: layouts/page.njk
title: Tags
permalink: /tags/
wide: true
schemaKind: CollectionPage
tags:
  - page
updated: 2026-10-22
breadcrumbs:
  - name: Home
    url: /
  - name: Tags
    url: /tags/
---
{% if collections.tagList.length %}
  <ul class="tag-list">
    {% for tag in collections.tagList %}
      {% set count = collections.posts | byTag(tag) | length %}
      <li><a href="/tag/{{ tag }}/">{{ tag | tagLabel }} ({{ count }})</a></li>
    {% endfor %}
  </ul>
{% else %}
  <p>No tags yet.</p>
{% endif %}
