<p>These pages group stories that share a company or a theme. They are indexes. The reporting, and the primary source for each claim, lives on the story.</p>
<ul class="story-list">
  {% for hub in topicHubs %}
    {% set stories = collections.posts | byAnyTag(hub.matchTags, hub.extraSlugs) %}
    <li>
      <article class="story">
        <div class="story-copy">
          <p class="kicker">{{ stories.length }} {{ "story" if stories.length == 1 else "stories" }}</p>
          <h2 class="story-title"><a href="/topics/{{ hub.slug }}/">{{ hub.title }}</a></h2>
          <p class="deck">{{ hub.description }}</p>
        </div>
      </article>
    </li>
  {% endfor %}
</ul>
