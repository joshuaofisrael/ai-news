---
layout: layouts/base.njk
title: Page not found
description: That page is not on AI Headline Hub. Try the latest stories, the archive, or a section.
permalink: /404.html
schemaKind: WebPage
robots: noindex
sitemap: false
breadcrumbs:
  - name: Home
    url: /
  - name: Page not found
    url: /404.html
---
<div class="wrap page">
  {% include "partials/breadcrumbs.njk" %}
  <h1>Page not found</h1>
  <p class="deck">That address is not a story or a section on {{ site.name }}.</p>
  <p class="inline-actions">
    <a class="button-link" href="/">Latest stories</a>
    <a class="button-link" href="/archive/">Archive</a>
  </p>
  <h2 class="section-title">Sections</h2>
  <ul class="tag-list">
    {% for category in categories %}
      <li><a href="/category/{{ category.slug }}/">{{ category.title }}</a></li>
    {% endfor %}
  </ul>
</div>
